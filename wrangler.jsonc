{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hivconnect-backend",
  "account_id": "77936f7f1fecd5df8504adaf96fad1fb",
  "compatibility_date": "2024-12-02",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
    // Enable MessagePort/MessageChannel for React 19/Next.js 15
    // Required for PayloadCMS compatibility with Workers runtime
    "expose_global_message_channel",
    // Enable WeakRef and FinalizationRegistry
    // Required for PayloadCMS v3 with Next.js 15
    "enable_weak_ref",
  ],
  // Workers-native logs and metrics. Off until now, which is why a runtime
  // failure could only be seen by reproducing it.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "login.hivconnectcentralnj.com",
      "zone_name": "hivconnectcentralnj.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "4dc8866a-3444-46b8-b73a-4def21b45772",
      "database_name": "hivconnect-db-production",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "hivconnect-media-production",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],
  "vars": {
    "PAYLOAD_PUBLIC_SERVER_URL": "https://login.hivconnectcentralnj.com",
    "DEPLOY_HOOK_URL": "https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/60788d5a-a22a-4bcf-a427-bdba665710d9",
    // PAYLOAD_SECRET and TURNSTILE_SECRET_KEY are intentionally NOT declared here.
    // They are encrypted secrets, managed via: wrangler secret put <NAME>
    // Declaring a secret as a plain var causes every deploy to overwrite it.
  },

  /*
   * Staging.
   *
   * hivconnect-db-staging and hivconnect-media-staging were provisioned on
   * 2025-12-02, in the same minute as the production pair, and then never
   * bound to anything. This connects them.
   *
   * Wrangler does NOT inherit vars, d1_databases or r2_buckets into a named
   * environment, so every one of them is repeated below on purpose. Deleting a
   * line here does not fall back to the production value, it removes the
   * binding. compatibility_date, compatibility_flags, main and observability
   * DO inherit, which is why they are not repeated.
   *
   * Deploy with:  pnpm exec wrangler deploy --env staging
   * Secrets are per-environment and must be set separately:
   *   wrangler secret put PAYLOAD_SECRET --env staging
   *   wrangler secret put TURNSTILE_SECRET_KEY --env staging
   *   wrangler secret put RESEND_API_KEY --env staging
   */
  "env": {
    "staging": {
      "name": "hivconnect-backend-staging",

      // workers.dev rather than a custom domain. A route on the production
      // zone would put staging in front of real visitors.
      "workers_dev": true,

      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },

      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "fc9ab010-f7bc-4dc2-8030-1438bb49a8cc",
          "database_name": "hivconnect-db-staging",
          "remote": true,
        },
      ],

      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "hivconnect-media-staging",
        },
      ],

      "vars": {
        "PAYLOAD_PUBLIC_SERVER_URL": "https://hivconnect-backend-staging.shuffle-seo.workers.dev",

        // Deliberately empty. Sharing the production deploy hook would mean a
        // content edit in staging rebuilds and republishes the LIVE website.
        "DEPLOY_HOOK_URL": "",
      },
    },
  }
}
